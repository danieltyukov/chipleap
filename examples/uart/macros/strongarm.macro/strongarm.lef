VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO strongarm
  CLASS BLOCK ;
  FOREIGN strongarm ;
  ORIGIN 10.950 0.600 ;
  SIZE 29.100 BY 40.800 ;
  PIN clk
    DIRECTION INPUT ;
    USE CLOCK ;
    ANTENNAGATEAREA 1.040000 ;
    PORT
      LAYER Metal4 ;
        RECT -6.150 -0.600 -5.850 7.090 ;
    END
  END clk
  PIN inm
    DIRECTION INPUT ;
    USE ANALOG ;
    ANTENNAGATEAREA 0.520000 ;
    PORT
      LAYER Metal4 ;
        RECT 14.250 -0.600 14.550 16.030 ;
    END
  END inm
  PIN inp
    DIRECTION INPUT ;
    USE ANALOG ;
    ANTENNAGATEAREA 0.520000 ;
    PORT
      LAYER Metal4 ;
        RECT -7.350 -0.600 -7.050 16.030 ;
    END
  END inp
  PIN outn
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.520000 ;
    ANTENNADIFFAREA 0.950000 ;
    PORT
      LAYER Metal4 ;
        RECT -8.550 -0.600 -8.250 17.930 ;
    END
  END outn
  PIN outp
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.520000 ;
    ANTENNADIFFAREA 0.950000 ;
    PORT
      LAYER Metal4 ;
        RECT 15.450 -0.600 15.750 17.930 ;
    END
  END outp
  PIN vdd
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER Metal4 ;
        RECT -9.750 -0.600 -9.450 26.470 ;
    END
  END vdd
  PIN vss
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal4 ;
        RECT -10.950 -0.600 -10.650 0.050 ;
    END
  END vss
  OBS
      LAYER GatPoly ;
        RECT 0.000 1.400 7.200 38.800 ;
      LAYER Metal1 ;
        RECT 0.000 1.400 7.200 38.800 ;
      LAYER Metal2 ;
        RECT 0.050 0.005 7.150 40.195 ;
      LAYER Metal3 ;
        RECT -10.945 0.000 18.145 40.200 ;
      LAYER Metal4 ;
        RECT -10.950 26.680 18.150 40.195 ;
        RECT -10.950 0.260 -9.960 26.680 ;
        RECT -10.950 0.250 -10.650 0.260 ;
        RECT -10.950 0.050 -10.900 0.250 ;
        RECT -10.440 -0.600 -9.960 0.260 ;
        RECT -9.240 18.140 18.150 26.680 ;
        RECT -9.240 -0.600 -8.760 18.140 ;
        RECT -8.040 16.240 15.240 18.140 ;
        RECT -8.040 -0.600 -7.560 16.240 ;
        RECT -6.840 7.300 14.040 16.240 ;
        RECT -6.840 -0.600 -6.360 7.300 ;
        RECT -5.640 -0.600 14.040 7.300 ;
        RECT 14.760 -0.600 15.240 16.240 ;
        RECT 15.960 -0.600 18.150 18.140 ;
  END
END strongarm
END LIBRARY

