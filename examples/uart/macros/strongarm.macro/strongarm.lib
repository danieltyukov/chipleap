/* strongarm: liberty view written by aispice 0.2.0, at corner tt_27.
   Pin capacitance is the extracted capacitance of each pin's net. An analog
   block has no timing arcs. */
library (strongarm_tt_27) {
  technology (cmos) ;
  delay_model : table_lookup ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  current_unit : "1uA" ;
  capacitive_load_unit (1, pf) ;
  pulling_resistance_unit : "1kohm" ;
  leakage_power_unit : "1nW" ;
  nom_process : 1 ;
  nom_temperature : 27 ;
  nom_voltage : 1.2 ;
  voltage_map (vdd, 1.2) ;
  voltage_map (vss, 0) ;
  cell (strongarm) {
    area : 1187.28 ;
    is_macro_cell : true ;
    dont_touch : true ;
    dont_use : true ;
    pg_pin (vdd) {
      pg_type : primary_power ;
      voltage_name : vdd ;
    }
    pg_pin (vss) {
      pg_type : primary_ground ;
      voltage_name : vss ;
    }
    pin (clk) {
      direction : input ;
      clock : true ;
      capacitance : 0.026841 ;
      related_power_pin : vdd ;
      related_ground_pin : vss ;
    }
    pin (inm) {
      direction : input ;
      is_analog : true ;
      capacitance : 0.004601 ;
      related_power_pin : vdd ;
      related_ground_pin : vss ;
    }
    pin (inp) {
      direction : input ;
      is_analog : true ;
      capacitance : 0.004601 ;
      related_power_pin : vdd ;
      related_ground_pin : vss ;
    }
    pin (outn) {
      direction : output ;
      capacitance : 0.025149 ;
      related_power_pin : vdd ;
      related_ground_pin : vss ;
    }
    pin (outp) {
      direction : output ;
      capacitance : 0.025199 ;
      related_power_pin : vdd ;
      related_ground_pin : vss ;
    }
  }
}
