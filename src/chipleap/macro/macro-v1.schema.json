{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/danieltyukov/chipleap/main/src/chipleap/macro/macro-v1.schema.json",
  "title": "Macro package manifest, macro/v1",
  "description": "macro.toml of a macro package shared by chipleap and aispice. The spec is docs/macro-package.md in both repositories. $defs/evidence describes evidence summaries and $defs/specs_file the measured spec table.",
  "type": "object",
  "required": ["schema", "name", "kind", "pdk", "producer", "size", "domains", "pins"],
  "properties": {
    "schema": {"const": "macro/v1"},
    "name": {"$ref": "#/$defs/identifier"},
    "kind": {"enum": ["analog", "digital"]},
    "description": {"type": "string"},
    "pdk": {"$ref": "#/$defs/pdk"},
    "producer": {
      "type": "object",
      "required": ["tool", "version"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"type": "string"}
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "required": ["width_um", "height_um"],
      "properties": {
        "width_um": {"type": "number", "exclusiveMinimum": 0},
        "height_um": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/domain"}
    },
    "pins": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pin"}
    },
    "corners": {
      "type": "array",
      "items": {"$ref": "#/$defs/corner"}
    },
    "extra": {"type": "object"}
  },
  "additionalProperties": false,
  "if": {"properties": {"kind": {"const": "analog"}}, "required": ["kind"]},
  "then": {"required": ["corners"], "properties": {"corners": {"minItems": 1}}},
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "maxLength": 64
    },
    "file_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
      "maxLength": 128
    },
    "pdk": {
      "type": "object",
      "required": ["name", "commit"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
      },
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "required": ["name", "voltage", "power", "ground"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "voltage": {"type": "number", "exclusiveMinimum": 0},
        "power": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}},
        "ground": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}
      },
      "additionalProperties": false
    },
    "pin": {
      "type": "object",
      "required": ["name", "direction", "kind"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "direction": {"enum": ["input", "output", "inout"]},
        "kind": {"enum": ["signal", "clock", "analog", "power", "ground"]},
        "domain": {"$ref": "#/$defs/identifier"},
        "width": {"type": "integer", "minimum": 1},
        "layer": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": false,
      "if": {"properties": {"kind": {"enum": ["power", "ground"]}}, "required": ["kind"]},
      "then": {
        "properties": {"direction": {"const": "inout"}, "domain": false, "width": false}
      },
      "else": {"required": ["domain"]}
    },
    "corner": {
      "type": "object",
      "required": ["name", "process", "temperature"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "process": {"type": "string", "minLength": 1},
        "temperature": {"type": "number"},
        "voltages": {
          "type": "object",
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        },
        "liberty": {"$ref": "#/$defs/file_name"}
      },
      "additionalProperties": false
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "description": "One summary in evidence/, macro.evidence/v1. Field names follow OpenADA's openada.result/v0alpha1.",
      "type": "object",
      "required": ["schema", "operation", "tool", "pdk", "engineering", "inputs"],
      "properties": {
        "schema": {"const": "macro.evidence/v1"},
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "tool": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string"}
          },
          "additionalProperties": false
        },
        "pdk": {"$ref": "#/$defs/pdk"},
        "engineering": {"$ref": "#/$defs/engineering"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}},
        "data": {"type": "object"}
      },
      "additionalProperties": false
    },
    "engineering": {
      "type": "object",
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["pass", "fail", "unknown", "not_applicable"]},
        "summary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "openada_result": {
      "description": "The fields of an OpenADA openada.result/v0alpha1 envelope that a macro package reads. OpenADA's own schema checks the rest.",
      "type": "object",
      "required": ["schema", "operation", "engineering"],
      "properties": {
        "schema": {"const": "openada.result/v0alpha1"},
        "operation": {"type": "string", "minLength": 1},
        "engineering": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"enum": ["pass", "fail", "unknown", "not_applicable"]}
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {"type": "string"},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "specs_file": {
      "description": "<name>.specs.toml, macro.specs/v1: measured specs per corner.",
      "type": "object",
      "required": ["schema", "specs"],
      "properties": {
        "schema": {"const": "macro.specs/v1"},
        "specs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spec"}}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["name", "unit", "measured"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string"},
        "unit": {"type": "string"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "typ": {"type": "number"},
        "measured": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number"}
        },
        "definition": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
